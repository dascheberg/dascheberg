  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="daschebergs Seite" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
</head>
<body>
  <div class="page-wrap">
    <nav class="xnavbar mx-4 mt-2">
      <a href="/">Home</a>
      <a href="/spiele">Spiele</a>
    </nav>
    <main>
      <div class="main">
        <slot />
      </div>
    </main>
  </div>
</body>
</html>
